---
import '~/styles/global.css';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/data/categories';

export interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  jsonLd?: object | object[];
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  canonical,
  jsonLd,
  bodyClass,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

const jsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const urlPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogRoute = urlPath === '' ? 'index' : urlPath;
const ogImageUrl = new URL(`/og/${ogRoute}.png`, Astro.site || 'https://toolbench.example').toString();

// Plausible analytics — privacy-friendly, no cookies, no PII.
// Domain is derived from astro.config.mjs `site` setting; toggle via env var
// PLAUSIBLE_DOMAIN to disable in dev/staging without code changes.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN
  || (Astro.site ? new URL(Astro.site).hostname : null);
const plausibleEnabled = !!plausibleDomain && import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D0F0E" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    {plausibleEnabled && (
      <script
        is:inline
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.outbound-links.js"
      ></script>
    )}
  </head>
  <body class={bodyClass}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
