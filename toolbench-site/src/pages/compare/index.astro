---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORY_LABELS } from '~/data/categories';
import { getLogoUrl } from '~/data/ai-logos';

const comparisons = await getCollection('comparisons', ({ data }) => !data.noindex);
const tools = await getCollection('tools');

const toolMap = new Map(tools.map(t => [t.slug, t]));

// Popularity = sum of A and B ratings (higher quality tools = more searched)
const enriched = comparisons
  .map(c => {
    const a = toolMap.get(c.data.toolA);
    const b = toolMap.get(c.data.toolB);
    if (!a || !b) return null;
    const popularity = a.data.rating + b.data.rating;
    return { c, a, b, popularity };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

// Sort by popularity desc
enriched.sort((x, y) => y.popularity - x.popularity);

const featured = enriched.slice(0, 6);
const trending = enriched.slice(6, 30);

// Group remaining by primary tool category for browseable index
const byCategory = new Map<string, typeof enriched>();
enriched.forEach(e => {
  const cat = e.a.data.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(e);
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI Tool Comparisons',
  description: `Browse ${comparisons.length}+ side-by-side AI tool comparisons. Find the right pick for your workflow.`,
  url: `${SITE.url}/compare`,
  numberOfItems: comparisons.length,
};
---

<BaseLayout
  title="All AI Tool Comparisons"
  description={`${comparisons.length}+ side-by-side comparisons of the top AI tools: ChatGPT vs Claude, Midjourney vs DALL-E, GitHub Copilot vs Cursor, and more.`}
  jsonLd={jsonLd}
>
  <div class="container">
    <section class="comparator-hero">
      <div class="eyebrow">Comparisons Library · 2026</div>
      <h1>
        Every AI tool, <em class="accent">side-by-side</em>
      </h1>
      <p class="hero-sub">
        {comparisons.length} head-to-head comparisons across {tools.length} AI tools. No fluff. Just specs, prices, and which one wins for your workflow.
      </p>
    </section>

    <!-- Featured / top comparisons -->
    <section class="compare-section">
      <h2 class="section-label">🔥 Most popular this week</h2>
      <div class="compare-featured-grid">
        {featured.map(({ c, a, b }) => (
          <a class="compare-featured-card" href={`/compare/${c.slug}`}>
            <div class="compare-featured-icons">
              <div class="compare-icon" style={`background:${a.data.iconBg};color:${a.data.iconColor}`}>
                {getLogoUrl(a.slug) ? (
                  <img src={getLogoUrl(a.slug)!} alt="" loading="lazy" decoding="async" width="28" height="28" />
                ) : a.data.icon}
              </div>
              <span class="compare-vs">VS</span>
              <div class="compare-icon" style={`background:${b.data.iconBg};color:${b.data.iconColor}`}>
                {getLogoUrl(b.slug) ? (
                  <img src={getLogoUrl(b.slug)!} alt="" loading="lazy" decoding="async" width="28" height="28" />
                ) : b.data.icon}
              </div>
            </div>
            <h3>{a.data.name} vs {b.data.name}</h3>
            <p class="compare-card-desc">{c.data.description}</p>
            <div class="compare-card-meta">
              <span class="compare-cat-tag">{CATEGORY_LABELS[a.data.category] || a.data.category}</span>
              <span class="compare-card-cta">Read comparison →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Trending list -->
    <section class="compare-section">
      <h2 class="section-label">📈 Trending comparisons</h2>
      <ul class="compare-list">
        {trending.map(({ c, a, b }) => (
          <li>
            <a href={`/compare/${c.slug}`} class="compare-list-item">
              <span class="compare-list-icons">
                <span class="compare-list-icon" style={`background:${a.data.iconBg};color:${a.data.iconColor}`}>
                  {getLogoUrl(a.slug) ? (
                    <img src={getLogoUrl(a.slug)!} alt="" loading="lazy" decoding="async" width="18" height="18" />
                  ) : a.data.icon}
                </span>
                <span class="compare-list-icon" style={`background:${b.data.iconBg};color:${b.data.iconColor}`}>
                  {getLogoUrl(b.slug) ? (
                    <img src={getLogoUrl(b.slug)!} alt="" loading="lazy" decoding="async" width="18" height="18" />
                  ) : b.data.icon}
                </span>
              </span>
              <span class="compare-list-name">{a.data.name} <em>vs</em> {b.data.name}</span>
              <span class="compare-list-arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Browse by category -->
    <section class="compare-section">
      <h2 class="section-label">🗂️ Browse all comparisons by category</h2>
      <div class="compare-category-grid">
        {Array.from(byCategory.entries())
          .sort((x, y) => y[1].length - x[1].length)
          .map(([cat, items]) => (
            <details class="compare-cat-block">
              <summary>
                <span class="compare-cat-name">{CATEGORY_LABELS[cat] || cat}</span>
                <span class="compare-cat-count">{items.length} comparisons</span>
              </summary>
              <ul class="compare-cat-list">
                {items.slice(0, 25).map(({ c, a, b }) => (
                  <li><a href={`/compare/${c.slug}`}>{a.data.name} vs {b.data.name}</a></li>
                ))}
                {items.length > 25 && (
                  <li class="compare-cat-more">+ {items.length - 25} more</li>
                )}
              </ul>
            </details>
          ))}
      </div>
    </section>

    <a class="cta-banner" href="/ai-comparator">
      <div class="cta-banner-text">
        <div class="cta-banner-eyebrow">Don't know which to compare?</div>
        <div class="cta-banner-title">Try the AI Matrix: see top picks for any task →</div>
      </div>
      <span class="btn btn-primary">Open the matrix</span>
    </a>
  </div>
</BaseLayout>
