---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CompareTable from '~/components/CompareTable.astro';
import ScoreWidget from '~/components/ScoreWidget.astro';
import FAQ from '~/components/FAQ.astro';
import WhyWon from '~/components/WhyWon.astro';
import SocialShare from '~/components/SocialShare.astro';
import { SITE } from '~/data/categories';

export async function getStaticPaths() {
  // Only build curated, indexable comparisons. The templated noindex pairs are
  // kept in the repo but not served: scaled near-duplicate pages are an AdSense
  // "low value content" / scaled-content liability and rank for nothing.
  const comparisons = await getCollection('comparisons', ({ data }) => !data.noindex);
  return comparisons.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'comparisons'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const allComparisons = await getCollection('comparisons');
const relatedComparisons = allComparisons
  .filter(c => c.slug !== entry.slug && !c.data.noindex && (
    c.data.toolA === d.toolA || c.data.toolB === d.toolA ||
    c.data.toolA === d.toolB || c.data.toolB === d.toolB
  ))
  .slice(0, 3);

const toolA = await getEntry('tools', d.toolA);
const toolB = await getEntry('tools', d.toolB);

if (!toolA || !toolB) {
  throw new Error(`Comparison ${entry.slug}: missing tool entry (${d.toolA}, ${d.toolB})`);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  image: `${SITE.url}/og/compare/${entry.slug}.webp`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE.url}/compare/${entry.slug}`,
  },
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  datePublished: d.publishedDate.toISOString().slice(0, 10),
  dateModified: d.updatedDate.toISOString().slice(0, 10),
  about: [
    {
      '@type': 'SoftwareApplication',
      name: toolA.data.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
    },
    {
      '@type': 'SoftwareApplication',
      name: toolB.data.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
    },
  ],
};

const faqSchema = d.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
} : null;

const updatedFmt = d.updatedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Compare',
      item: `${SITE.url}/ai-comparator`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${toolA.data.name} vs ${toolB.data.name}`,
      item: `${SITE.url}/compare/${entry.slug}`,
    },
  ],
};

const shareUrl = `${SITE.url}/compare/${entry.slug}`;

const schemas: object[] = [articleSchema, breadcrumbSchema];
if (faqSchema) schemas.push(faqSchema);
---

<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  jsonLd={schemas}
  noindex={d.noindex}
>
  <div class="container-narrow">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/">Compare</a>
      <span class="sep">/</span>
      <span>{toolA.data.name} vs {toolB.data.name}</span>
    </nav>

    <div class="eyebrow">In-Depth Comparison · Updated {updatedFmt}</div>
    <h1 style="margin-bottom:var(--s3)">{d.title}</h1>
    <p class="lead">{d.description}</p>

    <div class="verdict-box">
      <div class="label">Quick Verdict</div>
      <div class="text">{d.verdict}</div>
    </div>

    <h2 class="section-title">Feature comparison</h2>
    <CompareTable
      toolAName={toolA.data.name}
      toolBName={toolB.data.name}
      rows={d.features}
    />

    <hr class="divider" />

    <div class="article" style="max-width:none;margin-top:var(--s5)">
      <Content />
    </div>

    <hr class="divider" />

    <WhyWon toolA={toolA} toolB={toolB} />

    <hr class="divider" />

    <ScoreWidget
      toolAName={toolA.data.name}
      toolBName={toolB.data.name}
      toolAScores={toolA.data.scores}
      toolBScores={toolB.data.scores}
    />

    {d.recommendations.length > 0 && (
      <>
        <hr class="divider" />
        <h2 class="section-title" style="margin-top:var(--s5)">Final verdict by user type</h2>
        <div class="recs">
          {d.recommendations.map((r) => (
            <div class="rec">
              <div class="for">{r.for}</div>
              <div class="pick">Pick {r.pick}</div>
              <p>{r.reason}</p>
            </div>
          ))}
        </div>
      </>
    )}

    {d.faq.length > 0 && (
      <>
        <hr class="divider" />
        <FAQ items={d.faq} />
      </>
    )}

    {relatedComparisons.length > 0 && (
      <>
        <hr class="divider" />
        <h2 class="section-title" style="margin-top:var(--s5)">Related comparisons</h2>
        <div class="ra-grid">
          {relatedComparisons.map((c) => (
            <a class="ra-card" href={`/compare/${c.slug}`}>
              <div class="title">{c.data.title}</div>
            </a>
          ))}
        </div>
      </>
    )}

    <hr class="divider" />
    <SocialShare url={shareUrl} title={d.title} />
  </div>
</BaseLayout>
