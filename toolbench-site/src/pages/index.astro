---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolCard from '~/components/ToolCard.astro';
import CategoryFilter from '~/components/CategoryFilter.astro';
import Stats from '~/components/Stats.astro';
import { getCollection } from 'astro:content';
import { SITE, USE_CASES, CATEGORIES } from '~/data/categories';

const tools = await getCollection('tools');
// Group tools by category
const toolsByCategory = CATEGORIES.filter(c => c.id !== 'all').map(cat => {
  const catTools = tools.filter(t => t.data.category === cat.id);
  // Sort by rating within category
  catTools.sort((a, b) => b.data.rating - a.data.rating);
  return { cat, tools: catTools };
}).filter(group => group.tools.length > 0);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
  publisher: {
    '@id': `${SITE.url}/#organization`,
  },
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: tools.map((t, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: t.data.name,
      url: `${SITE.url}/reviews/${t.slug}`,
      applicationCategory: 'BusinessApplication'
    }
  }))
};
---

<BaseLayout title={undefined} jsonLd={[websiteSchema, itemListSchema]}>
  <div class="container">
    <section class="hero">
      <div class="eyebrow">AI Tools Directory — 2026</div>
      <h1>
        Real <em class="accent">verdicts</em> on the AI tools small businesses actually use.
      </h1>
      <p class="hero-sub">
        {SITE.totals.toolsReviewed} tools tested. {SITE.totals.comparisons} side-by-side comparisons. No vendor sponsorships, no affiliate kickbacks. Just straight talk on what works for your operations and what's quietly burning your monthly budget.
      </p>
      <form class="search" id="search-form" role="search">
        <input
          id="search-input"
          type="search"
          placeholder={`Search ${SITE.totals.toolsReviewed} tools — 'chatgpt', 'midjourney', 'image'...`}
          aria-label="Search tools"
        />
        <button type="submit">Search</button>
      </form>
    </section>

    <!-- AI Comparator promo -->
    <a class="comparator-promo" href="/ai-comparator">
      <div class="comparator-promo-inner">
        <div class="comparator-promo-text">
          <div class="comparator-promo-eyebrow">⚡ NEW · AI Matrix</div>
          <div class="comparator-promo-title">Find the best AI for any task</div>
          <div class="comparator-promo-sub">{tools.length} AI tools ranked across {USE_CASES.length} use cases — code, writing, images, video, and more.</div>
        </div>
        <div class="comparator-promo-chips">
          {USE_CASES.slice(0, 6).map(uc => (
            <span class="promo-chip">{uc.icon} {uc.label}</span>
          ))}
          <span class="promo-chip promo-chip-more">+{USE_CASES.length - 6} more</span>
        </div>
        <span class="btn btn-primary">Open the matrix →</span>
      </div>
    </a>

    <CategoryFilter />

    <div id="tools-container">
      {toolsByCategory.map(group => (
        <section class="category-section" data-cat-section={group.cat.id} style="margin-bottom:var(--s5);">
          <h2 class="section-title" style="margin-bottom:var(--s3);">{group.cat.icon} {group.cat.label} AI Tools</h2>
          <div class="tools-grid">
            {group.tools.map((tool) => (
              <ToolCard
                slug={tool.slug}
                name={tool.data.name}
                category={tool.data.category}
                icon={tool.data.icon}
                iconBg={tool.data.iconBg}
                iconColor={tool.data.iconColor}
                badge={tool.data.badge}
                rating={tool.data.rating}
                priceLabel={tool.data.priceLabel}
                description={tool.data.description}
                keywords={tool.data.keywords}
              />
            ))}
          </div>
        </section>
      ))}
      <div class="no-results" id="no-results" style="display:none; text-align:center; padding:var(--s4);">
        No tools match your search. Try a different keyword or
        <button type="button" id="reset-filters" class="link-style">reset filters</button>.
      </div>
    </div>

    <a class="cta-banner" href="/compare/chatgpt-vs-claude" style="margin-top:var(--s5);">
      <div class="cta-banner-text">
        <div class="cta-banner-eyebrow">Trending Comparison · This week</div>
        <div class="cta-banner-title">ChatGPT vs Claude — which is the better all-rounder in 2026?</div>
      </div>
      <span class="btn btn-primary">Compare side-by-side →</span>
    </a>

    <Stats />
  </div>

  <script>
    const container = document.getElementById('tools-container');
    const cards = container?.querySelectorAll<HTMLAnchorElement>('.card[data-cat]') ?? [];
    const sections = container?.querySelectorAll<HTMLElement>('.category-section') ?? [];
    const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
    const noResults = document.getElementById('no-results');
    const searchForm = document.getElementById('search-form') as HTMLFormElement | null;
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const resetLink = document.getElementById('reset-filters');

    let activeCat = 'all';
    let activeQuery = '';

    function applyFilter() {
      let totalVisible = 0;
      
      sections.forEach(sec => {
        let sectionVisibleCards = 0;
        const sectionCat = sec.dataset.catSection;
        const catMatch = activeCat === 'all' || sectionCat === activeCat;
        
        const secCards = sec.querySelectorAll<HTMLAnchorElement>('.card');
        secCards.forEach(c => {
          const q = activeQuery.toLowerCase().trim();
          const text = c.dataset.search || '';
          const queryMatch = !q || text.includes(q);
          const show = catMatch && queryMatch;
          
          c.classList.toggle('hidden', !show);
          if (show) {
            c.classList.remove('fade-in');
            void c.offsetWidth;
            c.classList.add('fade-in');
            sectionVisibleCards++;
            totalVisible++;
          }
        });
        
        // Hide entire section if no cards are visible
        sec.style.display = sectionVisibleCards > 0 ? 'block' : 'none';
      });

      if (noResults) noResults.style.display = totalVisible === 0 ? 'block' : 'none';
    }

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        pills.forEach((x) => {
          x.classList.remove('active');
          x.setAttribute('aria-selected', 'false');
        });
        p.classList.add('active');
        p.setAttribute('aria-selected', 'true');
        activeCat = p.dataset.cat || 'all';
        applyFilter();
      });
    });

    searchForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      activeQuery = searchInput?.value || '';
      applyFilter();
    });

    resetLink?.addEventListener('click', () => {
      activeCat = 'all';
      activeQuery = '';
      if (searchInput) searchInput.value = '';
      pills.forEach((x) => x.classList.remove('active'));
      document.querySelector('.pill[data-cat="all"]')?.classList.add('active');
      applyFilter();
    });

    // Initial route from ?cat= or ?q= query params
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('cat');
    const q = params.get('q');
    if (q && searchInput) {
      searchInput.value = q;
      activeQuery = q;
    }
    if (cat) {
      const target = document.querySelector<HTMLButtonElement>(`.pill[data-cat="${cat}"]`);
      if (target) {
        pills.forEach((x) => x.classList.remove('active'));
        target.classList.add('active');
        activeCat = cat;
      }
    }
    if (q || cat) applyFilter();
  </script>
</BaseLayout>
