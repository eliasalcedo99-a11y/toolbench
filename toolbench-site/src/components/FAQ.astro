---
export interface Item {
  q: string;
  a: string;
}
export interface Props {
  items: Item[];
}
const { items } = Astro.props;
const faqId = `faq-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="faq">
  <h2 class="section-title">Frequently asked</h2>
  {items.map((item, i) => {
    const answerId = `${faqId}-a-${i}`;
    return (
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false" aria-controls={answerId}>
          <span>{item.q}</span>
          <span class="ico" aria-hidden="true">+</span>
        </button>
        <div class="faq-a" id={answerId} role="region">{item.a}</div>
      </div>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-q').forEach((q) => {
    q.addEventListener('click', () => {
      const item = q.closest('.faq-item');
      if (!item) return;
      const open = item.classList.toggle('open');
      q.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
</script>
