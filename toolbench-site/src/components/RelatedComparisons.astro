---
export interface Item {
  slug: string;
  title: string;
}
export interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="related">
  {items.map((item) => (
    <a class="related-card" href={`/compare/${item.slug}`}>
      <div class="label">Comparison</div>
      <div class="title">{item.title}</div>
      <div class="arrow">Read comparison →</div>
    </a>
  ))}
</div>
