  "11_collectionpage_category_improved": {
    "_target": "`/category/<slug>` — Reemplazar CollectionPage actual. Añade mainEntity: ItemList con los tools de la categoría.",
    "schema": {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": "https://toolbench.netlify.app/category/<<slug>>#collection",
      "url": "https://toolbench.netlify.app/category/<<slug>>",
      "name": "Best <<Category>> AI Tools",
      "description": "<<150-char description>>",
      "isPartOf": { "@id": "https://toolbench.netlify.app/#website" },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Top <<Category>> AI Tools 2026",
        "numberOfItems": "<<count>>",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "url": "https://toolbench.netlify.app/reviews/<<tool-slug>>",
            "item": {
              "@type": "SoftwareApplication",
              "name": "<<Tool>>",
              "applicationCategory": "BusinessApplication",
              "operatingSystem": "Web"
            }
          }
        ]
      }
    }
