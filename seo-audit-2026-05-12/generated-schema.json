      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://toolbench.netlify.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "<<Category Name>>",
          "item": "https://toolbench.netlify.app/category/<<category-slug>>/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "<<Tool Name>>",
          "item": "https://toolbench.netlify.app/reviews/<<slug>>"
        }
      ]
    }
  },

